# Kopiera den här filen till .env och fyll i värdena.

# Neon Postgres — pooled anslutningssträng (host innehåller "-pooler")
DATABASE_URL=""
# Samma anslutning men UTAN "-pooler" i hostnamnet — krävs för migrationer
DIRECT_URL=""

# AI-funktioner: Gemini är GRATIS och föredras alltid när nyckeln finns.
# Skapa en kostnadsfri nyckel på https://aistudio.google.com (Get API key).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Valfri reserv: Anthropic Claude (betald per användning).
# Lämna tom för helt gratis drift — Gemini används då för allt.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Lösenordet du loggar in i appen med
APP_PASSWORD=""
# Slumpmässig sträng (minst 32 tecken) som signerar inloggnings-cookien.
# Generera t.ex. med: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
